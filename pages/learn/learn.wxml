<!--pages/learn/learn.wxml-->
<view class="learn-container">
  <!-- 顶部进度条 -->
  <view class="header">
    <view class="progress-info">
      <text class="progress-text">{{currentIndex + 1}}/{{totalCount}}</text>
      <button class="btn-pause" bindtap="onPause">暂停</button>
    </view>
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{(currentIndex / totalCount) * 100}}"></view>
    </view>
  </view>

  <!-- 学习卡片 -->
  <view class="word-card" wx:if="{{currentWord}}">
    <!-- 单词信息 -->
    <view class="word-info">
      <view class="korean-word">
        <text class="korean-text">{{currentWord.korean}}</text>
        <view class="audio-btn" bindtap="playAudio" wx:if="{{currentWord.audioUrl}}">
          <image src="/images/icon_audio.png" class="audio-icon"></image>
        </view>
      </view>

      <text class="pronunciation" wx:if="{{currentWord.pronunciation}}">[{{currentWord.pronunciation}}]</text>

      <view class="word-type">
        <text class="type-tag" wx:if="{{currentWord.type}}">{{currentWord.type}}</text>
        <text class="chinese-text">{{currentWord.chinese}}</text>
      </view>

      <!-- 词源信息 -->
      <view class="etymology-info" wx:if="{{currentWord.etymology}}">
        <text class="etymology-label">
          {{currentWord.origin === 'hanja' ? '汉字词' : currentWord.origin === 'loanword' ? '外来语' : '固有词'}}:
        </text>
        <text class="etymology-text">{{currentWord.etymology}}</text>
        <text class="source-lang" wx:if="{{currentWord.sourceLanguage}}">
          ({{currentWord.sourceLanguage === 'chinese' ? '汉语' : currentWord.sourceLanguage === 'english' ? '英语' : currentWord.sourceLanguage === 'german' ? '德语' : currentWord.sourceLanguage === 'japanese' ? '日语' : currentWord.sourceLanguage}})
        </text>
      </view>

      <!-- 难度标签 -->
      <view class="level-tag" wx:if="{{currentWord.topikLevel}}">
        <text class="level-text">TOPIK {{currentWord.topikLevel}}</text>
      </view>

      <!-- 例句 -->
      <view class="examples-section" wx:if="{{currentWord.examples && currentWord.examples.length > 0}}">
        <text class="examples-title">💡 例句</text>
        <view class="example-item" wx:for="{{currentWord.examples}}" wx:key="index">
          <text class="example-korean">{{item.korean}}</text>
          <text class="example-chinese">{{item.chinese}}</text>
        </view>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-buttons">
      <button
        class="btn-action btn-unknown"
        bindtap="onAnswer"
        data-answer="false"
      >
        还不认识
      </button>
      <button
        class="btn-action btn-know"
        bindtap="onAnswer"
        data-answer="true"
      >
        认识了
      </button>
    </view>
  </view>

  <!-- 完成页面 -->
  <view class="complete-page" wx:if="{{isCompleted}}">
    <view class="complete-icon">🎉</view>
    <text class="complete-title">今日完成！</text>
    <view class="complete-stats">
      <view class="stat-item">
        <text class="stat-value">{{newWordsCount}}</text>
        <text class="stat-label">新学</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{reviewWordsCount}}</text>
        <text class="stat-label">复习</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{correctCount}}</text>
        <text class="stat-label">答对</text>
      </view>
    </view>
    <button class="btn-primary" bindtap="onContinue">继续学习</button>
    <button class="btn-secondary" bindtap="onShare">分享成绩</button>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{isLoading}}">
    <text>加载中...</text>
  </view>
</view>
