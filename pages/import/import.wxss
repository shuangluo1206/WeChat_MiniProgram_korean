.container {
  padding: 40rpx;
  background: #FFF9FA;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  color: #F5A3B5;
}

/* 统计卡片 */
.stats-card {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(245, 163, 181, 0.15);
  margin-bottom: 40rpx;
}

.stat-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.stat-label {
  font-size: 32rpx;
  color: #6B7280;
}

.stat-value {
  font-size: 56rpx;
  font-weight: 700;
  color: #F5A3B5;
}

.divider {
  height: 2rpx;
  background: #FFF0F3;
  margin: 30rpx 0;
}

.stat-section {
  margin: 20rpx 0;
}

.section-title {
  font-size: 28rpx;
  color: #9CA3AF;
  display: block;
  margin-bottom: 20rpx;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.stat-item {
  text-align: center;
  padding: 20rpx;
  background: #FFF9FA;
  border-radius: 12rpx;
}

.item-label {
  display: block;
  font-size: 24rpx;
  color: #9CA3AF;
  margin-bottom: 8rpx;
}

.item-value {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #D67889;
}

/* 操作按钮 */
.actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #F5A3B5 0%, #D67889 100%);
  color: white;
  border: none;
  padding: 28rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.btn-secondary {
  background: #FFF0F3;
  color: #F5A3B5;
  border: none;
  padding: 28rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.btn-danger {
  background: white;
  color: #EF4444;
  border: 2rpx solid #EF4444;
  padding: 28rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
}

/* 提示信息 */
.tips {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  border-left: 6rpx solid #F5A3B5;
}

.tips-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #F5A3B5;
  margin-bottom: 20rpx;
}

.tips-text {
  display: block;
  font-size: 26rpx;
  color: #6B7280;
  line-height: 1.8;
  margin-bottom: 12rpx;
}
