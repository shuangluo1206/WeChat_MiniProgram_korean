<view class="container">
  <view class="header">
    <text class="title">词汇数据管理</text>
  </view>

  <!-- 统计信息 -->
  <view class="stats-card" wx:if="{{stats}}">
    <view class="stat-row">
      <text class="stat-label">总词汇量</text>
      <text class="stat-value">{{stats.total}}</text>
    </view>

    <view class="divider"></view>

    <view class="stat-section">
      <text class="section-title">按难度分布</text>
      <view class="stat-grid">
        <view class="stat-item">
          <text class="item-label">初级</text>
          <text class="item-value">{{stats.byLevel.beginner}}</text>
        </view>
        <view class="stat-item">
          <text class="item-label">中级</text>
          <text class="item-value">{{stats.byLevel.intermediate}}</text>
        </view>
        <view class="stat-item">
          <text class="item-label">高级</text>
          <text class="item-value">{{stats.byLevel.advanced}}</text>
        </view>
      </view>
    </view>

    <view class="divider"></view>

    <view class="stat-section">
      <text class="section-title">按词源分布</text>
      <view class="stat-grid">
        <view class="stat-item">
          <text class="item-label">汉字词</text>
          <text class="item-value">{{stats.byOrigin.hanja}}</text>
        </view>
        <view class="stat-item">
          <text class="item-label">外来语</text>
          <text class="item-value">{{stats.byOrigin.loanword}}</text>
        </view>
        <view class="stat-item">
          <text class="item-label">固有词</text>
          <text class="item-value">{{stats.byOrigin.native}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="actions">
    <button
      class="btn-primary"
      bindtap="onImport"
      disabled="{{importing}}"
    >
      {{importing ? '导入中...' : '批量导入词汇'}}
    </button>

    <button class="btn-secondary" bindtap="getStats">
      刷新统计
    </button>

    <button class="btn-danger" bindtap="onClear">
      清空所有数据
    </button>
  </view>

  <view class="tips">
    <text class="tips-title">💡 使用说明</text>
    <text class="tips-text">1. 点击"批量导入词汇"将JSON数据导入云数据库</text>
    <text class="tips-text">2. 导入前会弹窗确认，避免误操作</text>
    <text class="tips-text">3. "清空所有数据"会删除words集合的所有记录</text>
    <text class="tips-text">4. 导入完成后可在"学习"页面查看效果</text>
  </view>
</view>
