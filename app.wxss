/* app.wxss - 全局样式（粉白配色）*/

page {
  background-color: #FFF9FA;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  color: #2C2C2C;
}

/* 通用容器 */
.container {
  padding: 40rpx;
  min-height: 100vh;
}

/* 卡片样式 */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(245, 163, 181, 0.15);
  margin-bottom: 30rpx;
}

/* 按钮 */
.btn-primary {
  background: #F5A3B5;
  color: #FFFFFF;
  border-radius: 48rpx;
  padding: 28rpx 60rpx;
  font-size: 32rpx;
  border: none;
  box-shadow: 0 8rpx 16rpx rgba(245, 163, 181, 0.3);
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-secondary {
  background: #FFF0F3;
  color: #F5A3B5;
  border-radius: 48rpx;
  padding: 28rpx 60rpx;
  font-size: 32rpx;
  border: none;
}

/* 文字样式 */
.title {
  font-size: 44rpx;
  font-weight: 600;
  color: #2C2C2C;
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #6B7280;
  margin-bottom: 40rpx;
}

.text-gray {
  color: #6B7280;
}

.text-blue {
  color: #F5A3B5;
}

/* 进度条 */
.progress-bar {
  height: 8rpx;
  background: #FFF0F3;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #F5A3B5 0%, #D67889 100%);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

/* 加载动画 */
.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #6B7280;
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 200rpx 0;
  color: #6B7280;
}

.empty-state image {
  width: 300rpx;
  height: 300rpx;
  opacity: 0.5;
  margin-bottom: 40rpx;
}
